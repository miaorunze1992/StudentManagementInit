<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="co.jp.cloudbyte.StudentManagement.dao.UserRegisterInfoMapper">

<insert id="insertUserInfo" parameterType="co.jp.cloudbyte.StudentManagement.entity.UserRegisterInfo">
	INSERT INTO USER_INFO (
		USERNAME,
		PASSWORD
	)
	VALUES (
		#{username},
		#{userpassword}
	)
</insert>
    
</mapper>